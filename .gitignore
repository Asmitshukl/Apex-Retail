# ─── Python (pipeline/) ───────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
pipeline/.venv/
pipeline/venv/
*.egg-info/
dist/
build/
.eggs/

# Model weights (large files — track official pipeline models with Git LFS)
pipeline/weights/
*.pt
*.pth
*.onnx
*.onnx.data

!pipeline/models/
!pipeline/models/*.onnx
!pipeline/models/*.onnx.data
!pipeline/models/*.pt
!pipeline/models/classes.txt
!pipeline/models/README.md
!pipeline/models/.gitkeep

# Pipeline output (generated, not source)
pipeline/output/
*.jsonl

# ─── Node / Next.js (apex_fe/ + api/) ─────────────────
node_modules/
.next/
.turbo/
out/
dist/

# ─── Environment & Secrets ────────────────────────────
.env
.env.local
.env.*.local
.env.production
*.pem
*.key

# ─── Docker ───────────────────────────────────────────
docker-compose.override.yml

# ─── Pipeline input metadata + dataset ────────────────
# Keep tiny source metadata in git so Docker works on a fresh clone.
# Keep heavy CCTV footage, crops, and datasets out of git.
pipeline/data/*
!pipeline/data/
!pipeline/data/.gitkeep
!pipeline/data/store_layout.json
!pipeline/data/pos_transactions.csv
pipeline/data/clips/
pipeline/data/crops/
pipeline/data/**/*.mp4
pipeline/data/**/*.avi
pipeline/data/**/*.mov
pipeline/data/**/*.mkv
pipeline/data/**/*.jpg
pipeline/data/**/*.jpeg
pipeline/data/**/*.png
pipeline/data/**/*.zip

# ─── Dataset (never commit CCTV footage) ──────────────
*.mp4
*.avi
*.mov
*.mkv
dataset/
clips/

# ─── OS & Editor ──────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ─── Logs ─────────────────────────────────────────────
logs/
*.log
npm-debug.log*

# ─── Test & Coverage ──────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
coverage/
.nyc_output/

!pipeline/models/yolov8n.pt
